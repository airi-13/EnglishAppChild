# --- AI（Gemini）---
AI_MODE=gemini                 # gemini | mock（mockはAPIキー不要の動作確認用）
GEMINI_API_KEY=                # Google AI Studio で発行したキー（絶対に公開しない）
GEMINI_MODEL=gemini-flash-latest
AI_MAX_RPM=10                  # 1分あたりの最大AI呼び出し回数（無料枠の制限に合わせる）
AI_TIMEOUT=60                  # 1回のAI応答を待つ最大秒数
# GEMINI_THINKING_BUDGET=0     # 応答が遅いときだけ有効にする（考える量を減らして速くする。モデルによっては無効）
AI_MAX_RETRIES=2

# --- システム ---
DB_PATH=data/app.db
COOKIE_SECURE=0                # HTTPSで公開するときは 1
SESSION_DAYS=30
TZ_OFFSET_HOURS=9              # 集計に使う時差（日本=9）
